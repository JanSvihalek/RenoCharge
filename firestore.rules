rules_version = '2';

// Nabíjecí deník – pravidla pro Firestore.
//
// Zásada: klient smí sahat jen na vlastní data a relaci může uzavřít
// jen jednou. Po ukončení je záznam neměnný a nesmazatelný, aby se dal
// použít jako podklad pro fakturaci mimo aplikaci.
service cloud.firestore {
  match /databases/{database}/documents {

    function prihlasen() {
      return request.auth != null;
    }

    function ja() {
      return request.auth.uid;
    }

    // Nová podoba dokumentu.
    function nova() {
      return request.resource.data;
    }

    // Podoba dokumentu před zápisem.
    function stara() {
      return resource.data;
    }

    // Metadata fotky: cesta ve Storage, otisk, čas pořízení z EXIF a to,
    // jestli snímek vznikl v aplikaci, nebo byl vybraný z galerie.
    //
    // `zdroj` přibyl později a je **nepovinný** schválně: povinné nové pole
    // by okamžitě zneplatnilo každou verzi aplikace, která ho ještě
    // neposílá. Když chybí, čte se jako 'fotoaparat'.
    function platnaFoto(foto) {
      return foto.keys().hasOnly(['path', 'sha256', 'porizeno_at', 'zdroj'])
        && foto.keys().hasAll(['path', 'sha256', 'porizeno_at'])
        && foto.path is string
        && foto.path.size() > 0
        && foto.sha256 is string
        && foto.sha256.size() == 64
        && foto.porizeno_at is timestamp
        && (!foto.keys().hasAny(['zdroj'])
            || foto.zdroj in ['fotoaparat', 'galerie']);
    }

    // ── Profil uživatele ───────────────────────────────────────────────
    match /uzivatele/{uid} {
      function mujProfil() {
        return prihlasen() && uid == ja();
      }

      function povolenaPole() {
        return nova().keys().hasOnly([
          'jmeno', 'email', 'osobni_cislo', 'vytvoreno_at',
          'onboarding_at', 'aktivni_nabijeni_id', 'cena_za_kwh', 'role'
        ])
        && nova().jmeno is string
        && nova().jmeno.size() <= 80
        && nova().email is string
        && (!nova().keys().hasAny(['osobni_cislo'])
            || nova().osobni_cislo == null
            || (nova().osobni_cislo is string
                && nova().osobni_cislo.size() > 0
                && nova().osobni_cislo.size() <= 40))
        // Orientační sazba pro přepočet v aplikaci. Fakturuje se mimo ni,
        // takže na hodnotě nic nezávisí – jen ať to není nesmysl.
        && (!nova().keys().hasAny(['cena_za_kwh'])
            || nova().cena_za_kwh == null
            || (nova().cena_za_kwh is number
                && nova().cena_za_kwh > 0
                && nova().cena_za_kwh < 1000));
      }

      // Role rozhoduje o tom, co uživatel v aplikaci smí, takže si ji
      // nesmí nastavit sám – jinak by si každý připsal 'udrzba'. Přidává
      // ji výhradně správce v konzoli, kde pravidla neplatí.
      //
      // Porovnává se i přítomnost klíče, ne jen hodnota: bez toho by šlo
      // roli přidat do profilu, který ji dosud neměl.
      function roleNezmenena() {
        return nova().keys().hasAny(['role']) == stara().keys().hasAny(['role'])
          && (!nova().keys().hasAny(['role'])
              || nova().role == stara().role);
      }

      allow read: if mujProfil();

      // Profil zakládá aplikace při prvním přihlášení, a to bez role.
      allow create: if mujProfil()
        && povolenaPole()
        && !nova().keys().hasAny(['role']);

      // `vytvoreno_at` se zapisuje jen jednou, při vzniku profilu.
      allow update: if mujProfil()
        && povolenaPole()
        && nova().vytvoreno_at == stara().vytvoreno_at
        && roleNezmenena();

      allow delete: if false;

      // ── Vozidla uživatele ────────────────────────────────────────────
      match /vozidla/{vozidloId} {
        function moje() {
          return prihlasen() && uid == ja();
        }

        allow read: if moje();

        allow create, update: if moje()
          && nova().keys().hasOnly(['spz', 'znacka_model'])
          && nova().spz is string
          && nova().spz.size() > 0
          && nova().spz.size() <= 20
          && (nova().znacka_model == null
              || (nova().znacka_model is string
                  && nova().znacka_model.size() <= 60));

        // Vozidlo jde ze seznamu odebrat – SPZ je v relacích uložená
        // jako kopie textu, takže historie tím neutrpí.
        allow delete: if moje();
      }
    }

    // ── Nabíjecí relace ────────────────────────────────────────────────
    match /nabijeni/{relaceId} {
      function mojeRelace() {
        return prihlasen() && stara().uid == ja();
      }

      allow read: if mojeRelace();

      // Založit lze výhradně relaci ve stavu 'probiha' a bez koncových
      // hodnot – ty se doplní až při ukončení.
      allow create: if prihlasen()
        && nova().uid == ja()
        && nova().stav == 'probiha'
        && nova().keys().hasOnly([
          'uid', 'spz', 'vozidlo_id',
          'kwh_start', 'kwh_end', 'zahajeno', 'ukonceno',
          'foto_start', 'foto_end', 'stav',
          'vytvoreno_at', 'aktualizovano_at'
        ])
        && nova().keys().hasAll([
          'uid', 'spz', 'vozidlo_id',
          'kwh_start', 'zahajeno', 'foto_start', 'stav'
        ])
        && nova().spz is string
        && nova().spz.size() > 0
        && nova().vozidlo_id is string
        && nova().kwh_start is number
        && nova().kwh_start >= 0
        && nova().zahajeno is timestamp
        && platnaFoto(nova().foto_start)
        && nova().kwh_end == null
        && nova().ukonceno == null
        && nova().foto_end == null;

      // Jediná povolená změna je ukončení. Měnit se smí jen koncové
      // hodnoty; uid ani kwh_start nikdy.
      allow update: if mojeRelace()
        && stara().stav == 'probiha'
        && nova().stav == 'dokonceno'
        && nova().uid == stara().uid
        && nova().kwh_start == stara().kwh_start
        && nova().spz == stara().spz
        && nova().vozidlo_id == stara().vozidlo_id
        && nova().zahajeno == stara().zahajeno
        && nova().foto_start == stara().foto_start
        && nova().kwh_end is number
        && nova().kwh_end > stara().kwh_start
        && nova().ukonceno is timestamp
        && platnaFoto(nova().foto_end);

      allow delete: if false;
    }
  }
}
