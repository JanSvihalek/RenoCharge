<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Název pod ikonou na ploše. Na malých displejích se zkracuje
	     výpustkou, proto bez dovětků. -->
	<key>CFBundleDisplayName</key>
	<string>RenoCharge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>renocharge</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Prohlášení o šifrování pro exportní pravidla. Bez tohohle klíče se
	     App Store Connect ptá u každého nahraného buildu znovu a dokud
	     nedostane odpověď, nejde build poslat testerům.

	     `false` znamená, že aplikace nepoužívá šifrování nad rámec výjimek.
	     Odpovídá to skutečnosti: veškerá komunikace s Firebase jde po
	     běžném HTTPS, které poskytuje systém, a SHA-256 otisk fotky je
	     hashovací funkce, ne šifrování. Aplikace nemá vlastní klíče ani
	     šifrované lokální úložiště.

	     Kdyby někdy přibylo skutečné šifrování (třeba šifrovaná databáze
	     na zařízení), je potřeba tuhle hodnotu přehodnotit. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>NSCameraUsageDescription</key>
	<string>Fotoaparát slouží k vyfocení stavu počítadla na nabíječce před nabíjením a po něm.</string>
	<!-- Jen pro zápis (Add), ne pro čtení: aplikace do galerie ukládá
	     kopie vyfocených počítadel, když si to uživatel zapne
	     v nastavení. Vybírání fotek z galerie jde přes systémový PHPicker,
	     který oprávnění nepotřebuje – proto tu není klíč pro čtení.
	     Bez tohohle klíče iOS aplikaci při prvním zápisu ukončí. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Kopie vyfocených počítadel se ukládají do albumu RenoCharge, pokud si zálohování zapnete v nastavení aplikace.</string>
	<!-- Přihlášení firemním účtem se vrací do aplikace přes vlastní URL
	     schéma. U OIDC providerů (Microsoft) je to zakódované Firebase
	     App ID iOS aplikace: dvojtečky nahrazené pomlčkami, s předponou
	     „app-". Při změně Firebase projektu je potřeba schéma přegenerovat
	     z nového App ID (viz lib/firebase_options.dart, pole `appId`). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-750192659122-ios-30c426317ec8fe79b117ab</string>
			</array>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
