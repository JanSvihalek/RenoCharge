# Minimum musí sedět s IPHONEOS_DEPLOYMENT_TARGET v Runner.xcodeproj.
# Firebase 4.x vyžaduje iOS 15+, ML Kit pro rozpoznávání textu 15.5+ –
# držíme 16.0, ať je rezerva. Bez téhle řádky si CocoaPods domyslí
# výchozí hodnotu a instalace Firebase podů selže.
platform :ios, '16.0'

# CocoaPods posílá statistiky synchronně a zdržuje tím build.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Předkompilovaný Firestore. Pod z Firebase s sebou nese ~500 tisíc
  # řádků C++ (gRPC, abseil, BoringSSL), které se jinak při každém
  # buildu na CI překládají ze zdrojáků – to byla většina ze 40 minut
  # iOS buildu.
  #
  # Verze se bere z firebase_core, takže po aktualizaci pluginů sedí
  # sama. Kdyby pro novou verzi tag v repozitáři chyběl, pod install
  # selže s hláškou o chybějícím tagu – pak tenhle blok dočasně vypnout.
  #
  # Repozitář se od října 2026 nevyvíjí: Firebase ukončilo distribuci
  # přes CocoaPods a cesta dál je Swift Package Manager, kde je Firestore
  # předkompilovaný sám. Do té doby tohle drží build v rozumném čase.
  require File.join(
    File.dirname(File.realpath(__FILE__)),
    '.symlinks', 'plugins', 'firebase_core', 'ios', 'firebase_sdk_version.rb'
  )
  pod 'FirebaseFirestore',
      :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git',
      :tag => firebase_sdk_version!

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
