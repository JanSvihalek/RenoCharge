rules_version = '2';

// Nabíjecí deník – pravidla pro Firebase Storage.
//
// Ve Storage leží výhradně fotky počítadla, vždy na cestě
// `nabijeni/{uid}/{relaceId}/{start|end}.jpg`. Co nemá pravidlo,
// je zakázané.
//
// Vlastník je součástí cesty schválně. Dřív byla cesta bez uid
// (`nabijeni/{relaceId}/…`) a pravidla se musela na vlastníka doptávat
// Firestore přes `firestore.exists()`. Takové cross-service volání ale
// Firebase podmiňuje zvláštním IAM oprávněním pro servisní účet Storage;
// bez něj vyhodnocení pravidla selže a zápis se zamítne. To oprávnění
// není v repozitáři, nasazuje se mimo `firebase deploy` a jde tiše
// odebrat. S uid v cestě se vlastnictví ověří přímo z ní a na Firestore
// se pravidla neptají vůbec.
service firebase.storage {
  match /b/{bucket}/o {

    // Fotky odečtů elektroměrů. Roli tu ověřit nejde – muselo by se to
    // doptat Firestore a to je právě to cross-service volání, kvůli
    // kterému nešly nahrát fotky u nabíjení. Zápis proto smí kdokoli
    // přihlášený do své složky; že smí založit odečet, hlídá až Firestore.
    // Osiřelá fotka bez záznamu je pár set kB, ne bezpečnostní problém.
    match /odecty/{uid}/{soubor} {

      function moje() {
        return request.auth != null && uid == request.auth.uid;
      }

      // Odečty vidí celá firma, ne jen ten, kdo je pořídil.
      allow read: if request.auth != null;

      allow create: if moje()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';

      allow update: if false;
      allow delete: if false;
    }

    match /nabijeni/{uid}/{relaceId}/{soubor} {

      function moje() {
        return request.auth != null && uid == request.auth.uid;
      }

      function platnyObrazek() {
        return request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
      }

      function povolenyNazev() {
        return soubor == 'start.jpg' || soubor == 'end.jpg';
      }

      allow read: if moje();

      allow create: if moje() && povolenyNazev() && platnyObrazek();

      // Jednou nahraná fotka je neměnná – to je celý smysl otisku
      // SHA-256 v dokumentu relace.
      allow update: if false;

      // Mazat nesmí nikdo, ani vlastník. Bez dotazu do Firestore se tu
      // nedá poznat, jestli fotka patří k existujícímu záznamu, a nechat
      // uživatele mazat vlastní fotky by z důkazu udělalo přání.
      //
      // Cenou je, že po neúspěšném zahájení relace zůstane ve Storage
      // osiřelý snímek. Děje se to jen když selže transakce po úspěšném
      // nahrání, jde o stovky kB a uklidit se to dá dávkově zvenčí.
      allow delete: if false;
    }
  }
}
